# 依赖与构建产物
node_modules/
vendor/toolchain/
# release 下的构建产物一律忽略，只放行 V0.7.6-M3 的文字验收报告（不含任何素材本体）。
release/*
!release/large-project-acceptance.json
!release/memory-profile.json
!release/m3-memory-samples.json
!release/alpha-acceptance.json
!release/large-project-m3-generation.json
!release/m3-window-smoke.json
# V0.8.0：演出验收的文字报告与清单（不含素材、不含 exe、不含 30 MB 试玩 HTML）
!release/performance-window-smoke.json
!release/performance-benchmark.json
!release/wanfeng-v08-report.json
!release/wanfeng-v08-recording.json
!release/portable-dir-manifest.json
!release/v080-rc-game-verify.json
!release/audio-performance-benchmark.json
!release/audio-loop-benchmark.json
!release/v081-audio-window-html.json
!release/v081-audio-window-game.json
!release/wanfeng-v081-audio.json
release-*/
out-*/
out/
coverage/
# 1 GiB 验收工程在仓库外生成，防御性规则避免误提交素材本体
pvn-1gib-*/
pvn-1gib*/

# 本地环境
*.log
.env
.env.*
!.env.example

# 系统文件
.DS_Store
Thumbs.db

# 运行期生成、不入库：用户自己的工程目录、任何工程的备份快照
# 明确不忽略 assets/ 与 project.paper.json —— 以后要提交的示例工程必须能被跟踪。
# 源码根目录不允许出现工程产物，由 tests/workspace-hygiene.test.cjs 守住。
user-projects/
backups/
