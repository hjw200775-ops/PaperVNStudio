{
  "name": "paper-vn-studio",
  "version": "0.7.6",
  "private": true,
  "description": "纸间 PaperVNStudio — 视觉小说 / 文字冒险创作工具：Electron 桌面版与自包含 HTML 导出",
  "author": "wenwenwen817",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hjw200775-ops/PaperVNStudio.git"
  },
  "homepage": "https://github.com/hjw200775-ops/PaperVNStudio#readme",
  "bugs": {
    "url": "https://github.com/hjw200775-ops/PaperVNStudio/issues"
  },
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node scripts/serve.cjs",
    "check": "node scripts/check.cjs",
    "test": "node scripts/check.cjs",
    "desktop": "node scripts/desktop.cjs",
    "desktop:smoke": "node scripts/desktop.cjs --smoke",
    "desktop:smoke:packaged": "node scripts/packaged-smoke.cjs",
    "build:win": "node scripts/build-win.cjs all",
    "build:win:portable": "node scripts/build-win.cjs portable",
    "build:win:installer": "node scripts/build-win.cjs nsis",
    "desktop:smoke:project": "node scripts/desktop.cjs --smoke-project",
    "demo:acceptance": "node scripts/desktop.cjs --acceptance",
    "net:check": "node scripts/check-network.cjs",
    "chapters:acceptance": "node scripts/desktop.cjs --chapters",
    "branch:evidence": "node scripts/desktop.cjs --branch",
    "batch:acceptance": "node scripts/desktop.cjs --batch",
    "audio:acceptance": "node scripts/desktop.cjs --audio",
    "player:acceptance": "node scripts/desktop.cjs --player",
    "sample:build": "node scripts/build-sample.cjs",
    "sample:acceptance": "node scripts/desktop.cjs --sample",
    "game:build": "node scripts/build-game-package.cjs",
    "game:acceptance": "node scripts/game-package-acceptance.cjs",
    "game:icon": "node scripts/build-game-icon.cjs",
    "tools:prepare": "node scripts/prepare-game-toolchain.cjs",
    "export:acceptance": "node scripts/game-export-acceptance.cjs",
    "export:acceptance:packaged": "node scripts/game-export-acceptance.cjs --packaged",
    "interaction:acceptance": "node scripts/player-interaction-acceptance.cjs",
    "interaction:acceptance:packaged": "node scripts/player-interaction-acceptance.cjs --packaged",
    "music:acceptance": "node scripts/music-acceptance.cjs",
    "music:import": "node scripts/import-ost.cjs",
    "preview:acceptance": "node scripts/large-project-acceptance.cjs",
    "preview:acceptance:packaged": "node scripts/large-project-acceptance.cjs --packaged",
    "resources:report": "node scripts/resource-report.cjs",
    "make:large-project": "node scripts/make-large-project.cjs",
    "export:large": "node_modules/electron/dist/electron.exe scripts/export-large.cjs",
    "game:folder-smoke": "node scripts/game-folder-smoke.cjs",
    "assets:probe": "node scripts/cdp-probe.cjs",
    "assets:save-probe": "node scripts/cdp-save-probe.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "cn.papervnstudio.desktop",
    "productName": "PaperVNStudio",
    "asar": true,
    "compression": "normal",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "desktop/build-resources"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "package.json",
      "LICENSE",
      "!desktop/build-resources/**",
      "!**/*.test.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "PaperVNStudio-${version}-win-x64-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PaperVNStudio-${version}-win-x64-setup.${ext}"
    },
    "extraResources": [
      {
        "from": "vendor/toolchain",
        "to": "toolchain"
      },
      {
        "from": "desktop/game-pack-worker.cjs",
        "to": "worker/game-pack-worker.cjs"
      },
      {
        "from": "desktop/zip-writer.cjs",
        "to": "worker/zip-writer.cjs"
      }
    ]
  }
}
